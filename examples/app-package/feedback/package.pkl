// Example built-app package manifest (packaging plan §3.2): what the
// tangram-os exporter emits as `package.json` + `schema/changes.json` for a
// "feedback" app — one table, one declared resource type with a SQL-recipe
// action, one sandboxed component. Declared types are ordinary
// core.ResourceTypeDefinitions whose actions carry a sqlMapping — the same
// vocabulary manifest service apps use. Real packages depend on the released
// package and amend "@tangram-app-manifest/app-package.pkl" instead.
amends "../../../src/app-package.pkl"

import "../../../src/core.pkl"
import "../../../src/infra.pkl"

manifest {
  app {
    name = "feedback"
    title = "Feedback"
  }
  database = new infra.PostgresqlDatabaseClaim {
    resourceName = "app-database"
  }
  schema {
    checksum = "3bc9fbeb0d8eab162527f55562effa4b18596af2"
  }
  resourceTypeDefinitions {
    new core.ResourceTypeDefinition {
      name = "Note"
      doc = "A feedback note"
      sqlTable = "notes"
      instanceKey { "id" }
      includeCrud { "Create"; "List" }
      activeVersion = "v1"
      versions = List(new core.ResourceTypeVersion {
        version = "v1"
        served = true
        actions = List(new core.Action {
          name = "Approve"
          doc = "Mark a note done"
          privilege = "Approve"
          effect = core.Effect.Reversible
          idempotent = false
          requiresConfirmation = false
          sqlMapping = new core.SqlMapping {
            statement = "update notes set done = true, approved_by = :_actor, approved_at = :_now where id = :id"
            params {
              ["id"] = new core.SqlActionParam { type = "bigint" }
            }
          }
        })
      })
    }
  }
  components {
    new PackagedComponentEntry {
      name = "note-form"
      kind = "sandboxed"
    }
  }
  externalComponents {}
  storage = null
  roles = null
}

schemaChanges {
  changes {
    new CreateTable {
      table {
        name = "notes"
        columns {
          new ColumnSpec { name = "id"; type = "bigint"; nullable = false }
          new ColumnSpec { name = "note"; type = "text" }
          new ColumnSpec { name = "done"; type = "boolean" }
          new ColumnSpec { name = "approved_by"; type = "text" }
          new ColumnSpec { name = "approved_at"; type = "timestamptz" }
        }
        primaryKey { "id" }
      }
    }
    new AddIndex {
      index {
        name = "notes_done_idx"
        table = "notes"
        columns { "done" }
      }
    }
  }
  checksum = "3bc9fbeb0d8eab162527f55562effa4b18596af2"
}
