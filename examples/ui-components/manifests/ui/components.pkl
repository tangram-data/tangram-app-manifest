// Example `manifests/ui/components.pkl`. Real app packages depend on the
// released package and amend "@tangram-app-manifest/ui.pkl" instead.
amends "../../../../src/ui.pkl"

components {
  new AppUIComponentSpec {
    name = "top-accounts"
    kind = "declarative"
    description = "Top accounts by revenue for the selected period"
    spec = "ui/components/top-accounts.json"
    surfaces { "chat"; "dashboard"; "app-page" }
  }
  new AppUIComponentSpec {
    name = "churn-explorer"
    kind = "sandboxed"
    entry = "ui/components/churn-explorer.tsx"
    spec = new UIComponentContract {
      title = "Churn explorer"
      description = "Interactive monthly churn trend with CSV export"
      inputs {
        type = "object"
        properties {}
      }
      bindings {
        ["churn_series"] = new SqlBinding {
          sqlEngineId = "warehouse"
          sql = "SELECT month, churned FROM sales.churn WHERE month >= :since ORDER BY month"
          params {
            ["since"] = new Dynamic { from = "period" }
          }
        }
        ["export_csv"] = new ActionBinding {
          action = "sales/crm#Churn.Export"
          requiresConfirmation = false
        }
      }
      outputs {
        new UIComponentOutput {
          name = "select"
          payload {
            type = "object"
            required { "month" }
            properties {
              ["month"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "dashboard"; "app-page" }
  }
}
