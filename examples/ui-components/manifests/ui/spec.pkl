// Example `manifests/ui/spec.pkl`. Real app packages depend on the released
// package and import "@tangram-app-manifest/ui.pkl" instead.
import "../../../../src/ui.pkl" as ui

components: Listing<ui.AppUIComponentSpec> = new Listing {
  new ui.AppUIComponentSpec {
    name = "top-accounts"
    kind = "declarative"
    description = "Top accounts by revenue for the selected period"
    spec = "components/top-accounts.json"
    surfaces { "chat"; "dashboard"; "app-page" }
  }
  new ui.AppUIComponentSpec {
    name = "churn-explorer"
    kind = "sandboxed"
    entry = "components/churn-explorer.tsx"
    spec = new ui.UIComponentContract {
      title = "Churn explorer"
      description = "Interactive monthly churn trend with CSV export"
      inputs {
        type = "object"
        properties {}
      }
      bindings {
        ["churn_series"] = new ui.SqlBinding {
          sqlEngineId = "warehouse"
          sql = "SELECT month, churned FROM sales.churn WHERE month >= :since ORDER BY month"
          params {
            ["since"] = new Dynamic { from = "period" }
          }
        }
        ["export_csv"] = new ui.ActionBinding {
          action = "sales/crm#Churn.Export"
          requiresConfirmation = false
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "select"
          payload {
            type = "object"
            required { "month" }
            properties {
              ["month"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "dashboard"; "app-page" }
  }
}
