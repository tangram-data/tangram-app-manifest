// Reproducible pre-refactor contract fixture. This uses the published 1.1.3
// package, where the declarations still lived in core.pkl. Keep its values in
// lockstep with fixture.pkl; verifyContractFixture compares both rendered forms.
module ai.tangram.os.examples.contractfixturepre2

import "package://pkg.pkl-lang.org/github.com/tangram-data/tangram-app-manifest/tangram-app-manifest@1.1.3#/core.pkl" as core
import "package://pkg.pkl-lang.org/github.com/tangram-data/tangram-app-manifest/tangram-app-manifest@1.1.3#/deployment.pkl" as deployment

// --- resource types / actions / IAM -----------------------------------------

local openApiAction = new core.Action {
  name = "Rename"
  privilege = core.Privilege.Write
  effect = core.Effect.Reversible
  idempotent = true
  doc = "Rename a record"
  skipAuth = false
  skipAudit = false
  requiresConfirmation = true
  additionalPrivileges = List(new core.ResourcePrivilegeRequirement {
    resourceType = "Workspace"
    privilege = core.Privilege.Describe
    resourceName = List(new core.PathParam { name = "workspace" })
  })
  openApiMapping = new core.OpenApiMapping {
    operationId = "renameRecord"
    resourceName = List(
      new core.PathParam { name = "recordId" },
      new core.QueryParam { name = "revision" },
      new core.BodyField { path = "record.meta[0].name" },
      new core.ResponseField { path = "record.id" }
    )
    resourceId = new core.BodyField { path = "record.id" }
    newName = new core.BodyField { path = "record.newName" }
    resourceNameTemplate = "[{{getNameById(requestBody.record.id)}}]"
    resourceIdTemplate = "{{requestBody.record.id}}"
    newNameTemplate = "{{requestBody.record.newName}}"
  }
  surface = new core.ActionSurface {
    kind = "card"
    title = "Record"
    fields = List("id", "name")
  }
}

local multiMappingAction = new core.Action {
  name = "List"
  privilege = core.Privilege.Read
  effect = core.Effect.Stateless
  idempotent = true
  doc = "List records"
  openApiMappings = List(
    new core.OpenApiMapping { operationId = "listRecordsNative" },
    new core.OpenApiMapping { operationId = "listRecordsWrapper" }
  )
}

local sqlAction = new core.Action {
  name = "Approve"
  privilege = "Approve"
  effect = core.Effect.Reversible
  idempotent = false
  doc = "Approve a note"
  requiresConfirmation = false
  sqlMapping = new core.SqlMapping {
    statement = "update notes set done = true where id = :id"
    params {
      ["id"] = new core.SqlActionParam { type = "bigint" }
    }
  }
}

local handlerAction = new core.Action {
  name = "Notify"
  effect = core.Effect.Irreversible
  idempotent = false
  doc = "Notify the owner"
  handlerMapping = new core.HandlerMapping {
    handler = "notes.notify"
    params {
      ["id"] = new core.SqlActionParam { type = "bigint" }
    }
  }
}

local serviceTypeDefinition = new core.ResourceTypeDefinition {
  name = "Record"
  doc = "A record resource"
  activeVersion = "v2"
  superType = core.DATASET_TYPE
  scopeType = core.WORKSPACE_TYPE
  scopePrivilegePropagation = Map("Admin", List("Read", "Write"))
  versions = List(
    new core.ResourceTypeVersion {
      version = "v1"
      served = false
      actions = List(multiMappingAction)
    },
    new core.ResourceTypeVersion {
      version = "v2"
      served = true
      superTypeVersion = "v1"
      actions = List(openApiAction, multiMappingAction)
      presetRoles = List(new core.Role {
        name = "owner"
        permissions = List("*")
        description = "Full control of the record"
      })
    }
  )
}

local sqlBackedTypeDefinition = new core.ResourceTypeDefinition {
  name = "Note"
  doc = "A SQL-backed note"
  activeVersion = "v1"
  sqlTable = "notes"
  instanceKey { "id" }
  includeCrud { "Create"; "List" }
  versions = List(new core.ResourceTypeVersion {
    version = "v1"
    served = true
    actions = List(sqlAction, handlerAction)
  })
}

// --- integration -------------------------------------------------------------

local integrationImpl = new core.IntegrationImplementation {
  interface = core.SQL_QUERYABLE
  implementationSpec = new Dynamic { endpoint = "http://sql.example" }
  implementationType = "http"
  version = "v1"
}

local queryableSpec = new core.TangramSQLQueryableSpec {
  sqlCommandPrivilegeMapping = Map("SELECT", List("Read"))
}

// --- connector auth / settings ----------------------------------------------

local connectorAuth = new core.ConnectorAuth {
  httpHeaders = Map(
    "Authorization", new core.Template { template = "Bearer {{oauth.accessToken}}" }
  )
}

local configField = new core.ConfigField {
  name = "apiBase"
  description = "Upstream API base URL"
  required = true
  default = "https://api.example.com"
  example = "https://api.example.com"
}

// --- observability / helm ----------------------------------------------------

local otlpObservability = new core.ComponentObservability {
  traces = "otlp"
  metrics = new core.OtlpMetrics {}
  targetContainers = List("server")
}

local prometheusObservability = new core.ComponentObservability {
  metrics = new core.PrometheusMetrics {
    port = 9090
    path = "/custom/metrics"
    scheme = "https"
    interval = "15s"
    sampleLimit = 5000
  }
}

local helmChart = new core.HelmChart {
  repo = "https://charts.example.com"
  fullName = "example/starrocks"
  version = "1.2.3"
  components = List(new core.HelmComponent {
    name = "fe"
    apiServiceComponent = true
    recommendedReplica = 1
    maxReplica = 3
    optional = false
    initContainers = List(new core.ContainerMeta {
      name = "init"
      image = "example/init:1"
      description = "Init container"
    })
    containers = List(new core.ContainerMeta {
      name = "fe"
      image = "example/fe:1"
    })
  })
  observability = otlpObservability
  crds = List(new core.CustomResourceRbac {
    apiGroup = "starrocks.com"
    resources = List("starrocksclusters", "starrocksclusters/status")
  })
}

// --- ui / manifest identity ---------------------------------------------------

local uriPattern = new core.UriPattern { pattern = "/app/*" }

local identity = new Dynamic {
  specVersion = core.MANIFEST_SPEC_VERSION
  groupName = core.TANGRAM_OS_GROUP_NAME
  coreApp = core.TANGRAM_OS_CORE_APP
  appTypes = List(core.NATIVE_APP_TYPE, core.CONNECTOR_APP_TYPE, core.AGENT_APP_TYPE)
  superTypes = List(
    core.WORKSPACE_TYPE, core.DATASET_TYPE, core.CATALOG_TYPE,
    core.STORAGE_TYPE, core.DATABASE_TYPE, core.COMPUTE_TYPE,
    core.SQL_ENGINE_TYPE, core.WORKFLOW_TYPE, core.DASHBOARD_TYPE
  )
  integrationApps = List(core.TANGRAM_SQL_APP, core.DATA_CATALOG_APP)
  interfaces = List(core.SPARK_IO, core.SQL_QUERYABLE, core.SCHEMA_UPDATOR)
}

// --- custom component deployment ----------------------------------------------

local componentSpec = new deployment.AppComponentSpec {
  service = new deployment.AppComponentServiceSpec {
    port = 80
    targetPort = 8080
    protocol = "TCP"
  }
  initContainers = List(new deployment.AppContainerSpec {
    ports = List()
    variables = Map("MODE", "init")
    files = List()
    command = List("sh", "-c", "init")
  })
  containers = List(new deployment.AppContainerSpec {
    ports = List(8080)
    variables = Map(
      "API_KEY", new deployment.SecretValue { value = "secret-ref" },
      "LOG_LEVEL", "info"
    )
    files = List(new deployment.ContainerFile {
      name = "config"
      path = "/etc/app/config.yaml"
      isSensitive = true
      content = "key: value"
    })
    command = List("server")
    args = List("--port", "8080")
  })
}

local containerMeta = new core.ContainerMeta {
  name = "server"
  image = "example/server:1"
  description = "Main container"
}

local deploymentContext = new deployment.DeploymentContext {
  id = "dep-1"
  tangramOSPublicUrl = "https://os.example.com"
  workspace = "ws-1"
  k8sNamespace = "app-ns"
  cloudProvider = "AWS"
}

// --- rendered contract ----------------------------------------------------------

fixture = new Dynamic {
  identity_ = identity
  serviceTypeDefinition_ = serviceTypeDefinition
  sqlBackedTypeDefinition_ = sqlBackedTypeDefinition
  integrationImpl_ = integrationImpl
  queryableSpec_ = queryableSpec
  connectorAuth_ = connectorAuth
  configField_ = configField
  otlpObservability_ = otlpObservability
  prometheusObservability_ = prometheusObservability
  helmChart_ = helmChart
  uriPattern_ = uriPattern
  componentSpec_ = componentSpec
  containerMeta_ = containerMeta
  deploymentContext_ = deploymentContext
}
