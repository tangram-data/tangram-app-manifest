module ai.tangram.os.manifest

// Current manifest schema version. Apps should reference this in app.pkl as:
//   manifestSpecVersion = manifest.MANIFEST_SPEC_VERSION
MANIFEST_SPEC_VERSION = "v1"

TANGRAM_OS_GROUP_NAME = "ai.tangram-os"

class AppName {
  group: String
  name: String
}

TANGRAM_OS_CORE_APP = new AppName {
  group = TANGRAM_OS_GROUP_NAME
  name = "core"
}

class ResourceType {
  app: AppName
  name: String
}

class ConfigField {
  name: String
  description: String
  required: Boolean
  default: String?
  example: String?
}

NATIVE_APP_TYPE    = "NativeApp"
CONNECTOR_APP_TYPE = "ConnectorApp"
// Agent apps are LLM-driven services declared in `manifests/agent/spec.pkl`
// (see `agent.pkl`). They have no HTTP service of their own; tools are
// declared at the manifest level and bound to backends at install time.
AGENT_APP_TYPE     = "Agent"
typealias AppType  = "NativeApp"|"ConnectorApp"|"Agent"
