module ai.tangram.os.deployment

typealias CloudProvider = "Local"|"AWS"|"Azure"|"GCP"|"Scaleway"|"Ovh"

/// Platform-issued Kubernetes Secret carrying the app service-account token.
/// Authors reference this typed binding from Helm values instead of deriving
/// platform Secret names from namespaces or naming conventions.
class ServiceAccountTokenSecret {
  name: String
  tokenKey: String = ".auth_token"
}

class DeploymentContext {
  id: String
  tangramOSPublicUrl: String
  workspace: String
  k8sNamespace: String
  cloudProvider: CloudProvider
  serviceAccountTokenSecret: ServiceAccountTokenSecret
}

// ---------------------------------------------------------------------------
// Telemetry collection
//
// The platform attributes every signal to the workspace from the namespace
// label it controls, so manifests never name an index or workspace.
// ---------------------------------------------------------------------------
abstract class MetricsCollection {
  kind: String
}

/// Push: inject the platform OTLP metrics endpoint into target containers.
class OtlpMetrics extends MetricsCollection {
  kind: String = "otlp"
}

/// Pull: scrape a workload's Prometheus endpoint and convert it to OTLP.
class PrometheusMetrics extends MetricsCollection {
  kind: String = "prometheus"
  port: Int
  path: String = "/metrics"
  scheme: "http"|"https" = "http"
  interval: String = "30s"
  sampleLimit: Int?
}

class ComponentObservability {
  /// Distributed tracing: "otlp" injects the OTLP trace endpoint env.
  traces: "otlp"|"none" = "none"
  metrics: MetricsCollection?
  /// Defaults to all non-init containers when omitted.
  targetContainers: List<String>?
}

// ---------------------------------------------------------------------------
// Shared deployment metadata
// ---------------------------------------------------------------------------
class ContainerMeta {
  name: String
  /// Image reference: `repository[:tag]` or `repository@sha256:<digest>`.
  /// Tags keep authoring simple; pin a digest when you need the reference to
  /// be immutable and byte-reproducible across installs.
  image: String(matches(Regex(#"\S+"#)))
  description: String?
}

// ---------------------------------------------------------------------------
// Custom Kubernetes deployment types
//
// Used by deployment/components.pkl (non-Helm apps). AppComponentMeta is a
// PKL annotation so the platform can discover metadata without evaluating the
// full component specification.
// ---------------------------------------------------------------------------
class ContainerFile {
  name: String
  path: String
  isSensitive: Boolean? = false
  content: String
}

class AppComponentServiceSpec {
  port: Int
  targetPort: Int
  protocol: String
}

/// Closed set of source runtimes. Each identifier maps in platform
/// configuration to an immutable builder/base-image recipe; adding a value is
/// a platform capability release.
typealias SourceRuntime = "python-3.12"

/// A component's single source-built primary container. Every field must be a
/// schema-time constant literal — no settings, secrets, dependency outputs, or
/// deployment context. By convention the complete source tree lives under
/// `deployment/source/<component-name>/`; `sourceDir` (relative to
/// `deployment/`, package-local) overrides that for monorepo layouts.
class SourceArtifact {
  /// Name of the synthesized primary container (position zero in the
  /// normalized container sequence). Unique within the component.
  containerName: String(!isEmpty)
  runtime: SourceRuntime
  /// Interpreted by the runtime contract; for `python-3.12` a dotted module
  /// name resolved under the source `src/` tree, launched as `python -m <entry>`.
  entry: String(!isEmpty)
  /// Relative to the source directory; `python-3.12` requires a `uv.lock`.
  lockfile: String(!isEmpty)
  sourceDir: String(!isEmpty)?
}

/// A publicly reachable HTTP subtree of the component's Service. The platform
/// reconciles the exposure behind its dedicated public host with managed TLS
/// and edge guardrails; the endpoint's own authentication stays with the app.
/// Every field must be a schema-time constant literal.
class PublicEndpoint {
  /// Stable name; part of the public URL
  /// (`https://public.<domain>/<workspace>/<appGroup>/<appName>/<name>/...`).
  name: String(matches(Regex(#"[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?"#)))
  /// Only this path subtree of the component's Service becomes publicly
  /// reachable; requests are forwarded as `<pathPrefix>/<rest>`. Must be a
  /// canonical absolute path: no empty, `.` or `..` segments, no query,
  /// fragment or percent-encoding.
  pathPrefix: String(matches(Regex(#"/|(/[A-Za-z0-9._~-]+)+"#)), !contains(".."), !contains("/./"), !endsWith("/."))
  /// Request-body cap enforced at the edge; the platform clamps to its own maximum.
  maxBodyBytes: Int(isPositive) = 1048576
  /// Approximate per-client-IP rate limit at the edge (fairness brake, not a
  /// precise global cap); absolute budgets remain the app's responsibility.
  rateLimitRps: Int(isPositive) = 100
  /// Human-readable purpose, shown in the install/upgrade approval diff.
  doc: String(!isEmpty)
}

class AppComponentMeta extends Annotation {
  /// Also the component's Kubernetes Service name, so it must be a DNS-1035 label.
  name: String(matches(Regex(#"[a-z]([-a-z0-9]{0,61}[a-z0-9])?"#)))
  initContainers: List<ContainerMeta>?
  containers: List<ContainerMeta>
  /// When present, Tangram builds this source into the component's primary
  /// container; `containers` then describe prebuilt sidecars.
  sourceArtifact: SourceArtifact?
  maxReplica: Int?
  recommendedReplica: Int? = 1
  optional: Boolean? = false
  /// Per-component telemetry collection (absent = platform default / none).
  observability: ComponentObservability?
  /// Publicly exposed HTTP subtrees of this component's Service (absent = the
  /// component is cluster-internal, reachable only through the platform).
  publicEndpoints: List<PublicEndpoint>(isDistinctBy((e) -> e.name))?
}

class SecretValue {
  value: String
}

class AppContainerSpec {
  ports: List<Int>
  variables: Map<String, String|SecretValue>
  files: List<ContainerFile>
  command: List<String>
  args: List<String>?
}

class AppComponentSpec {
  service: AppComponentServiceSpec?
  initContainers: List<AppContainerSpec>?
  containers: List<AppContainerSpec>
}

// ---------------------------------------------------------------------------
// Helm deployment metadata
//
// These are plain data classes, not annotations. The platform evaluates the
// `charts` expression and JSON-decodes it into HelmChartMeta.
// ---------------------------------------------------------------------------
class HelmComponent {
  name: String
  recommendedReplica: Int?
  maxReplica: Int?
  optional: Boolean?
  initContainers: List<ContainerMeta>?
  containers: List<ContainerMeta>
}

/// Static request for high-impact Helm capabilities. The request is not
/// permission: registration records it, installation preflight compares it
/// with target policy, the approval artifact shows it, and rendered output
/// may not exceed it — an unrequested hook, CRD, or cluster-scoped kind is a
/// hard planning failure.
class HelmRequestedCapabilities {
  hooks: Boolean = false
  crds: Boolean = false
  clusterScopedKinds: Set<String> = Set()
}

class CustomResourceRbac {
  apiGroup: String
  resources: List<String>
  verbs: List<String> = List("create", "get", "list", "watch", "update", "delete", "patch")
}

class HelmChart {
  repo: String
  fullName: String
  version: String
  requestedCapabilities: HelmRequestedCapabilities = new HelmRequestedCapabilities {}
  components: List<HelmComponent>
  observability: ComponentObservability?
  crds: List<CustomResourceRbac>?
}
