module ai.tangram.os.componentContract

// ---------------------------------------------------------------------------
// Sandboxed component render contract — typed PKL authoring for the contract
// JSON referenced by `AppUIComponentSpec.spec` (ui.pkl).
//
// The platform consumes JSON, so amend this template and render at packaging
// time; the manifest keeps pointing at the rendered `.contract.json`:
//
//   // ui/components/churn-explorer.contract.pkl
//   amends "@tangram-app-manifest/component-contract.pkl"
//   title = "Churn explorer"
//   description = "Monthly churn trend with CSV export"
//   bindings {
//     ["churn_series"] = new SqlBinding {
//       sqlEngineId = "warehouse"
//       sql = "SELECT month, churned FROM sales.churn WHERE month >= :since ORDER BY month"
//       params { ["since"] = new Dynamic { from = "period" } }
//     }
//   }
//
//   pkl eval -f json -o churn-explorer.contract.json churn-explorer.contract.pkl
//
// Never declares `bundle` or `view` — the platform fills `bundle.ref` from the
// compiled `entry`, and a contract carrying either is rejected at indexing.
// ---------------------------------------------------------------------------

/// Semantic-layer binding (preferred; governed, dialect-portable).
/// `semanticQuery` may carry `{{…}}` templates resolved server-side at render.
class SemanticBinding {
  fixed type: String = "semantic"
  semanticModels: Listing<String>
  semanticQuery: Dynamic
}

/// Parameterized SQL bound to a `sqlEngineId` (escape hatch). `params` values
/// are template strings or `{ from = "<input>" }` references; they bind as SQL
/// parameters at the facade, never string-concatenated.
class SqlBinding {
  fixed type: String = "sql"
  sqlEngineId: String(!isEmpty)?
  sql: String(!isEmpty)
  params: Mapping<String, Any>?
}

/// An app action invoked via the perform gateway with IAM + confirmation.
/// `action` address shape: `<group>/<name>#<ResourceType>.<action>`.
class ActionBinding {
  fixed type: String = "action"
  action: String(!isEmpty)
  requiresConfirmation: Boolean?
}

typealias ComponentBinding = SemanticBinding|SqlBinding|ActionBinding

/// An event the component may emit to the host; `payload` is a JSON Schema.
class OutputSpec {
  name: String(!isEmpty)
  payload: Dynamic?
}

/// Human-readable title; overrides the manifest component name in the catalog.
title: String(!isEmpty)?

/// One-line summary of what the component shows; drives agent discovery.
/// Takes precedence over the manifest entry's `description`.
description: String(!isEmpty)?

/// JSON Schema object describing render input parameters.
inputs: Dynamic?

/// Named data/effect bindings callable from the in-frame SDK (`query`/`action`).
bindings: Mapping<String, ComponentBinding>?

/// Events the component may emit via the in-frame SDK (`emit`).
outputs: Listing<OutputSpec>?

output {
  renderer = new JsonRenderer {
    omitNullProperties = true
  }
}
