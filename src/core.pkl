module ai.tangram.os

// Current manifest schema version. Apps should reference this in app.pkl as:
//   manifestSpecVersion = tangram.MANIFEST_SPEC_VERSION
MANIFEST_SPEC_VERSION = "v1"

TANGRAM_OS_GROUP_NAME = "ai.tangram-os"

class AppName {
  group: String
  name: String
}

TANGRAM_OS_CORE_APP = new AppName {
  group = TANGRAM_OS_GROUP_NAME
  name = "core"
}

class ResourceType {
  app: AppName
  name: String
}

// ---------------------------------------------------------------------------
// Privilege constants
//
// Privileges are open strings — any value is accepted so apps can define
// domain-specific privileges (e.g. "Approve", "Publish").
// These well-known constants are provided for convenience and referenced by
// the platform for built-in policy evaluation.
//
// Usage in resource_types.pkl:
//   local Describe = tangram.Privilege.Describe
//   ...or just use the string directly: privilege = "Describe"
// ---------------------------------------------------------------------------
class _PrivilegeConstants {
  Describe: String = "Describe"
  Read:     String = "Read"
  Write:    String = "Write"
  Create:   String = "Create"
  Delete:   String = "Delete"
  Admin:    String = "Admin"
  Execute:  String = "Execute"
}
Privilege: _PrivilegeConstants = new _PrivilegeConstants {}

// ---------------------------------------------------------------------------
// Effect constants
//
// Characterises what an action does to the world. Drives AI autonomy decisions,
// audit policy, and UI affordances.
//
//   Stateless    — reads only; no state change; AI executes autonomously; audit skipped by default
//   Reversible   — mutates state; prior state restorable; audit always recorded
//   Irreversible — mutates state; cannot be undone; AI requires confirmation; audit always recorded
// ---------------------------------------------------------------------------
class _EffectConstants {
  Stateless:    String = "Stateless"
  Reversible:   String = "Reversible"
  Irreversible: String = "Irreversible"
}
Effect: _EffectConstants = new _EffectConstants {}

// ---------------------------------------------------------------------------
// Resource name extractors
//
// Used in OpenApiMapping.resourceName and ResourcePrivilegeRequirement.resourceName
// to identify which parts of an HTTP request form the resource name.
// ---------------------------------------------------------------------------
/// Discriminated union of extractors that identify where a resource's name segments
/// come from in an HTTP request. The `type` property is emitted in the JSON output and
/// the platform uses it to disambiguate variants — PKL's JSON renderer doesn't carry
/// class identity, so without an explicit discriminator a `PathParam` and a `QueryParam`
/// would both serialise as `{"name":"x"}` and the runtime couldn't tell them apart.
abstract class ResourceNameExtractor {
  type: String
}

/// Extracts from a URL path parameter (OpenAPI `in: path`).
class PathParam extends ResourceNameExtractor {
  type: String = "PathParam"
  name: String
}

/// Extracts from a URL query-string parameter (OpenAPI `in: query`). Distinguished
/// from `PathParam` so the runtime gateway resolves the correct value even when an
/// operation declares a path param and a query param with the same name (legal per
/// the OpenAPI spec — parameter uniqueness is the pair `(name, in)`).
class QueryParam extends ResourceNameExtractor {
  type: String = "QueryParam"
  name: String
}

/// Extracts from a request body field. The path is a dot-separated traversal that
/// may include array indices inline, e.g. `obj.arrayField[0].name`.
class BodyField extends ResourceNameExtractor {
  type: String = "BodyField"
  path: String
}

/// Extracts from a response body field (dot-separated path). Useful when a resource's
/// identifier or name is server-assigned and only known after the upstream service
/// has responded (e.g. mlflow's `createExperiment` returns `experiment_id`).
class ResponseField extends ResourceNameExtractor {
  type: String = "ResponseField"
  path: String
}

// ---------------------------------------------------------------------------
// OpenAPI mapping — binds an action to one HTTP operationId.
// ---------------------------------------------------------------------------
class OpenApiMapping {
  operationId: String
  /// How to extract the resource name from the request. When omitted, the platform
  /// derives it from path parameters in URL order. May also be omitted when
  /// `resourceId` is provided — the platform resolves the name via the ID lookup.
  resourceName: List<ResourceNameExtractor>?
  /// How to extract an opaque resource identifier from the request (or response).
  /// Used for APIs that identify resources by server-assigned IDs rather than by
  /// hierarchical name (e.g. mlflow's `experiment_id`, `run_id`). The platform
  /// resolves the ID against its resource registry to get the actual resource.
  resourceId: ResourceNameExtractor?
  /// For Rename / Update actions, where the new name comes from. Single value
  /// (the resource's name after rename), not a list of segments.
  newName: ResourceNameExtractor?
  /// Escape hatch — raw Jinja template for the resource name. Required when the
  /// template needs function calls the typed extractors can't express:
  /// `getNameById(...)`, `evaluateLater(...)`, `ifEmpty(...)`. When set, takes
  /// precedence over `resourceName` (the typed form is ignored).
  /// Example: "[{{getNameById(requestBody.experiment_id)}}, {{requestBody.run_name}}]"
  resourceNameTemplate: String?
  /// Escape hatch — raw Jinja template for the resource ID. Takes precedence over
  /// `resourceId` when set.
  resourceIdTemplate: String?
  /// Escape hatch — raw Jinja template for the new name on Rename/Update. Takes
  /// precedence over `newName` when set.
  newNameTemplate: String?
}

// ---------------------------------------------------------------------------
// Additional privilege check — cross-resource authorization required on an action.
// ---------------------------------------------------------------------------
class ResourcePrivilegeRequirement {
  /// Resource type identifier: "group/app/TypeName" or just "TypeName" if same app.
  resourceType: String
  privilege: String
  resourceName: List<ResourceNameExtractor>
}

// ---------------------------------------------------------------------------
// Action
// ---------------------------------------------------------------------------

/// Inline chat render hint for an action's result. The chat host renders the
/// result accordingly (a card/picker/… instead of raw text/JSON). Presentation
/// only — it never affects routing, IAM, or the result data. Omit for plain
/// text/JSON output.
class ActionSurface {
  /// How the chat host renders this action's result inline.
  kind: "card"|"picker"|"confirm"|"form"|"none"
  /// Optional title for card-style surfaces.
  title: String?
  /// Output fields to display (card). Omit to show all top-level output fields.
  fields: List<String>?
}

class Action {
  name: String
  /// Privilege class this action belongs to.
  /// Defaults to the action name when it matches a well-known privilege.
  privilege: String?
  /// Characterises the action's effect: Stateless, Reversible, or Irreversible.
  effect: String
  idempotent: Boolean
  doc: String
  skipAuth: Boolean?
  skipAudit: Boolean?
  requiresConfirmation: Boolean?
  additionalPrivileges: List<ResourcePrivilegeRequirement>?
  /// HTTP binding for a single operationId.
  openApiMapping: OpenApiMapping?
  /// HTTP bindings for multiple operationIds (e.g. native API + Tangram wrapper API).
  openApiMappings: List<OpenApiMapping>?
  /// Optional inline chat render hint for this action's result.
  surface: ActionSurface?
}

// ---------------------------------------------------------------------------
// ReBAC role declaration
// ---------------------------------------------------------------------------

/// A named role for the carrying resource type, declaring the privileges
/// the role grants per-resource-instance under the ReBAC model.
///
/// Each ReBAC row in `resource_relations` carries a role name; at check
/// time the platform resolves the role's `permissions` against the
/// requested privilege. Roles whose name matches a parent type's role
/// SHADOW (replace) the parent role — declaring `name = "owner"` here
/// fully overrides any inherited `owner`.
///
/// `permissions` may contain the wildcard `"*"`, which expands at
/// platform registration time to the full action set declared on this
/// resource type's `actions` list (including actions inherited via
/// `superTypeVersion`). Use sparingly — a wildcard role grants every
/// future action added to the type without further review.
class Role {
  /// Role name. Unique within the carrying ResourceTypeVersion. Used as
  /// the value of `resource_relations.role` for grants.
  name: String

  /// The privileges this role grants on a resource the principal holds
  /// this role on. Names must be declared actions of the type (or `"*"`).
  permissions: List<String>

  /// Human-readable description shown in admin UIs.
  description: String
}

// ---------------------------------------------------------------------------
// Resource type versioning
// ---------------------------------------------------------------------------
class ResourceTypeVersion {
  version: String
  served: Boolean
  superTypeVersion: String?
  actions: List<Action>
  /// ReBAC role declarations for instances of this resource type.
  /// Roles inherit from the supertype version (if any); a role with the
  /// same name as an inherited role REPLACES (shadows) it — there is no
  /// permission union. Omit (or leave empty) to inherit unchanged.
  presetRoles: List<Role>?
}

class ResourceTypeDefinition {
  name: String
  doc: String
  activeVersion: String
  versions: List<ResourceTypeVersion>
  superType: ResourceType?
  scopeType: ResourceType?
  /// (Reserved — not yet enforced by the platform IAM.) Maps a parent-scope privilege
  /// to the list of child privileges it grants. Will become operative when the IAM
  /// permission-check query consults this field; until then, declaring it has no
  /// runtime effect — prefer to omit it on new manifests to avoid drift.
  scopePrivilegePropagation: Map<String, List<String>>?
}

