module ai.tangram.os.ui

// ---------------------------------------------------------------------------
// App-published UI components
//
// An app publishes reusable UI components to the App Hub catalog by shipping
// `manifests/ui/components.pkl` in its package. The platform evaluates the
// `components` expression of that file and indexes each entry under the
// namespaced catalog name `{group}/{app}/{name}`. Declarative components are
// indexed at registration; sandboxed components are catalogued once the
// publish-time bundle transform lands.
//
// Use in `manifests/ui/components.pkl`:
//   amends "@tangram-app-manifest/ui.pkl"
//   components {
//     new AppUIComponentSpec {
//       name = "top-accounts"
//       kind = "declarative"
//       spec = "ui/components/top-accounts.json"
//       surfaces { "chat"; "dashboard"; "app-page" }
//     }
//   }
// ---------------------------------------------------------------------------

/// Authoring tier: `declarative` is a JSON view spec rendered by the trusted
/// frontend renderer; `sandboxed` is app-authored source run in a sandboxed iframe.
typealias UIComponentKind = "declarative"|"sandboxed"

/// Surfaces a component may render on.
typealias UIComponentSurface = "chat"|"dashboard"|"app-page"

/// Semantic-layer binding (preferred; governed, dialect-portable).
/// `semanticQuery` may carry `{{…}}` templates resolved server-side at render.
class SemanticBinding {
  fixed type: String = "semantic"
  semanticModels: Listing<String>
  semanticQuery: Dynamic
}

/// Parameterized SQL bound to a `sqlEngineId` (escape hatch). `params` values
/// are template strings or `{ from = "<input>" }` references; they bind as SQL
/// parameters at the facade, never string-concatenated.
class SqlBinding {
  fixed type: String = "sql"
  sqlEngineId: String(!isEmpty)?
  sql: String(!isEmpty)
  params: Mapping<String, Any>?
}

/// An app action invoked via the perform gateway with IAM + confirmation.
/// `action` address shape: `<group>/<name>#<ResourceType>.<action>`.
class ActionBinding {
  fixed type: String = "action"
  action: String(!isEmpty)
  requiresConfirmation: Boolean?
}

/// How a sandboxed component gets data or causes effects.
typealias UIComponentBinding = SemanticBinding|SqlBinding|ActionBinding

/// An event the component may emit to the host; `payload` is a JSON Schema.
class UIComponentOutput {
  name: String(!isEmpty)
  payload: Dynamic?
}

/// A sandboxed component's render contract: what the in-frame SDK may call
/// (`query`/`action`), what inputs it takes, and what it emits. Never declares
/// `bundle` or `view` — the platform fills `bundle.ref` from the compiled `entry`.
class UIComponentContract {
  /// Human-readable title; overrides the component name in the catalog.
  title: String(!isEmpty)?

  /// One-line summary of what the component shows; drives agent discovery.
  /// Takes precedence over the manifest entry's `description`.
  description: String(!isEmpty)?

  /// JSON Schema object describing render input parameters.
  inputs: Dynamic?

  /// Named data/effect bindings callable from the in-frame SDK.
  bindings: Mapping<String, UIComponentBinding>?

  /// Events the component may emit via the in-frame SDK (`emit`).
  outputs: Listing<UIComponentOutput>?
}

/// One published UI component. Artifact paths (`spec` as a path, `entry`) are
/// relative to the `manifests/` directory and must stay inside it — absolute
/// paths and `..` traversal are rejected at indexing time.
class AppUIComponentSpec {
  /// Component name; catalogued as `{group}/{app}/{name}` (no cross-app collisions).
  name: String(!isEmpty)

  /// Authoring tier. `declarative` requires a `spec` path and forbids `entry`;
  /// `sandboxed` requires `entry` and may carry `spec` (contract).
  kind: UIComponentKind(
    this != "declarative" || (spec is String && entry == null),
    this != "sandboxed" || entry != null
  )

  /// One-line summary of what the component shows. Drives agent discovery
  /// (intent matching in `tangram_list_components`); used as a fallback when
  /// the `spec` artifact carries no `description` of its own.
  description: String(!isEmpty)?

  /// Where the component may render.
  surfaces: Listing<UIComponentSurface>

  /// Declarative: path to the full component JSON artifact, e.g.
  /// "ui/components/top-accounts.json". Sandboxed (optional): the render
  /// contract, either inline as a typed [UIComponentContract] or as a path to
  /// an equivalent contract JSON.
  spec: (String(!isEmpty)|UIComponentContract)?

  /// Sandboxed only: path to the TSX/JSX source entry, transformed to a bundle
  /// at publish.
  entry: String(!isEmpty)?
}

/// The UI components this app publishes.
components: Listing<AppUIComponentSpec> = new Listing<AppUIComponentSpec> {}
